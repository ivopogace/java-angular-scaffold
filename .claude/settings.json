{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MCP_TIMEOUT": "60000"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(node scripts/verify.mjs)",
      "Bash(node scripts/verify.mjs --quick)",
      "Bash(node scripts/check-agent-docs.mjs)",
      "Bash(./gradlew *)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files*)"
    ]
  }
}
