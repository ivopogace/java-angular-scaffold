{
  "name": "scaffold-starter",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development --localize",
    "test": "ng test",
    "extract-i18n": "ng extract-i18n",
    "test:coverage": "ng test --watch=false --coverage --coverage-include=\"src/**/*.ts\" --coverage-exclude=\"src/testing/**\" --coverage-reporters=text-summary --coverage-reporters=lcovonly --coverage-reporters=html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "lint": "ng lint && stylelint \"src/**/*.scss\"",
    "test:eslint-rules": "node --test \"eslint-rules/*.test.mjs\" \"stylelint/*.test.mjs\""
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@fontsource/roboto": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.4",
    "@angular/localize": "22.2.4",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
