{
  "customSyntax": "postcss-scss",
  "plugins": ["./stylelint/overrides-no-color-literal.mjs"],
  "rules": {
    "selector-pseudo-element-disallowed-list": ["ng-deep"],
    "selector-disallowed-list": ["/\\.mdc-/", "/\\.mat-mdc-/"],
    "color-no-hex": true,
    "color-named": "never",
    "function-disallowed-list": [
      "rgb",
      "rgba",
      "hsl",
      "hsla",
      "hwb",
      "lab",
      "lch",
      "oklab",
      "oklch",
      "color"
    ],
    "local/overrides-no-color-literal": true
  },
  "overrides": [
    {
      "files": ["src/styles.scss"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null,
        "local/overrides-no-color-literal": null
      }
    }
  ]
}
